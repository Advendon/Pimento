{
  "name": "drop-of-colour-crm",
  "version": "1.0.0",
  "description": "CRM and management system for DROP OF COLOUR printshop",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node src/database/seed.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "crm",
    "printshop",
    "management",
    "typescript",
    "postgresql"
  ],
  "author": "DROP OF COLOUR",
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "pg": "^8.11.0",
    "prisma": "^5.22.0"
  }
}
